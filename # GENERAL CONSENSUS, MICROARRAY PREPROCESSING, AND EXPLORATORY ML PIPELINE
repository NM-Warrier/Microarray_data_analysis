setwd("path/to/working_directory")

# ===============================================================
# CREATE DIRECTIONAL CONSENSUS DEG LISTS
# One workbook per comparison; one iteration per worksheet.
# All worksheets must use the same contrast direction and log2 FC units.
# Include iteration sheets only (no summaries or other tables).
# ===============================================================

library(readxl)
library(openxlsx)
library(dplyr)
library(stringr)

# ===============================================================
# PATHS AND THRESHOLDS
# ===============================================================

model_dir <- "path/to/input_directory"
output_dir <- file.path(model_dir, "Directional_Consensus_DEGs")
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

adjusted_p_cutoff <- 0.05
absolute_log2fc_cutoff <- 1 # Edit for your analysis.
stopifnot(adjusted_p_cutoff > 0, adjusted_p_cutoff <= 1,
          is.finite(absolute_log2fc_cutoff), absolute_log2fc_cutoff >= 0)

# ===============================================================
# DEG FILES: replace these placeholders; add or remove entries.
# ===============================================================

deg_files <- c(
  "Comparison_A_DEGs_AllIterations.xlsx",
  "Comparison_B_DEGs_AllIterations.xlsx"
)

# ===============================================================
# HELPER FUNCTION
# ===============================================================

find_col <- function(df, possible_names) {
  matched <- possible_names[possible_names %in% colnames(df)]
  if (length(matched) == 0) return(NA_character_)
  matched[1]
}

# ===============================================================
# MAIN LOOP
# ===============================================================

for (file in deg_files) {
  cat("Processing:", file, "\n")
  comparison_name <- str_remove(file, "_DEGs_AllIterations\\.xlsx$")
  comparison_name <- str_remove(comparison_name, "\\.xlsx$")
  file_path <- file.path(model_dir, file)
  sheets <- excel_sheets(file_path)
  all_deg_list <- list()

  # =========================================================
  # READ EACH ITERATION SHEET
  # =========================================================

  for (sh in sheets) {
    cat("Reading sheet:", sh, "\n")
    df <- as.data.frame(read_excel(file_path, sheet = sh))

    # Edit aliases below if your column names differ.
    # Choose one consistent identifier type across all sheets.
    gene_col <- find_col(df, c("GeneSymbol", "gene_symbol", "Gene", "gene", "SYMBOL", "Symbol", "gene_id", "ProbeID"))
    logfc_col <- find_col(df, c("logFC", "LogFC", "log2FC", "log2FoldChange", "estimate"))
    padj_col <- find_col(df, c("adj.P.Val", "padj", "p.adjust", "FDR"))

    if (anyNA(c(gene_col, logfc_col, padj_col))) {
      stop("Required columns missing in file: ", file, " sheet: ", sh)
    }
    # 'estimate' is supported only when it represents a log2 fold change.
    for (column in c(logfc_col, padj_col)) {
      original <- df[[column]]
      converted <- suppressWarnings(as.numeric(as.character(original)))
      if (any(!is.na(original) & is.na(converted))) {
        stop("Nonnumeric values in ", column, " | ", file, " | ", sh)
      }
      df[[column]] <- converted
    }
    if (any(df[[padj_col]] < 0 | df[[padj_col]] > 1, na.rm = TRUE)) {
      stop("Adjusted P values must be between 0 and 1: ", file, " | ", sh)
    }

    df_filtered <- df %>%
      filter(is.finite(.data[[logfc_col]]), is.finite(.data[[padj_col]]),
             abs(.data[[logfc_col]]) >= absolute_log2fc_cutoff,
             .data[[logfc_col]] != 0,
             .data[[padj_col]] < adjusted_p_cutoff) %>%
      mutate(Iteration = sh,
             GeneSymbol = trimws(as.character(.data[[gene_col]])),
             logFC_value = .data[[logfc_col]],
             adj_p_value = .data[[padj_col]],
             Direction = ifelse(logFC_value > 0, "Up", "Down")) %>%
      dplyr::select(Iteration, GeneSymbol, logFC_value, adj_p_value, Direction, everything())
    all_deg_list[[sh]] <- df_filtered
  }

  # =========================================================
  # COMBINE ALL ITERATIONS
  # =========================================================

  all_deg <- bind_rows(all_deg_list)

  # =========================================================
  # CREATE DIRECTIONAL CONSENSUS LIST
  # Direction must agree among all significant rows for an identifier.
  # Nonsignificant rows do not participate in this directional check.
  # Repeated IDs count once per iteration; means below summarize all rows.
  # =========================================================

  directional_consensus <- all_deg %>%
    filter(!is.na(GeneSymbol), GeneSymbol != "") %>%
    group_by(GeneSymbol) %>%
    summarise(
      Iterations_Present = n_distinct(Iteration),
      Direction_List = paste(unique(Direction), collapse = ";"),
      Consensus_Direction = first(Direction),
      Mean_logFC = mean(logFC_value),
      Median_logFC = median(logFC_value),
      Min_adj_p_value = min(adj_p_value),
      Mean_adj_p_value = mean(adj_p_value),
      .groups = "drop"
    ) %>%
    filter(!str_detect(Direction_List, ";")) %>%
    arrange(desc(Iterations_Present), Min_adj_p_value)

  # =========================================================
  # STRICT CONSENSUS: significant in the same direction in ALL iterations
  # =========================================================

  n_iterations <- length(sheets)
  strict_consensus <- directional_consensus %>%
    filter(Iterations_Present == n_iterations)

  # =========================================================
  # SAVE OUTPUTS
  # =========================================================

  write.xlsx(all_deg,
             file.path(output_dir, paste0(comparison_name, "_Filtered_DEGs_AllIterations.xlsx")),
             rowNames = FALSE, overwrite = TRUE)
  write.xlsx(directional_consensus,
             file.path(output_dir, paste0(comparison_name, "_Directional_Consensus_DEGs.xlsx")),
             rowNames = FALSE, overwrite = TRUE)
  write.xlsx(strict_consensus,
             file.path(output_dir, paste0(comparison_name, "_Strict_Directional_Consensus_DEGs.xlsx")),
             rowNames = FALSE, overwrite = TRUE)

  cat("Filtered DEG rows:", nrow(all_deg), "\n")
  cat("Directional consensus identifiers:", nrow(directional_consensus), "\n")
  cat("Strict consensus identifiers:", nrow(strict_consensus), "\n")
}

# Consensus counts are descriptive; mean/minimum adjusted P values are not
# combined significance tests. Overlapping iterations are not independent studies.
capture.output(sessionInfo(), file = file.path(output_dir, "session_info.txt"))
cat("All directional consensus DEG lists created.\n")

