# ===============================================================
# PCA + OUTLIER REVIEW BEFORE AND AFTER BATCH CORRECTION
# ===============================================================

make_pca <- function(expr_mat, info, stage) {
  stopifnot(identical(colnames(expr_mat), info$SampleID), ncol(expr_mat) >= 3)
  variable <- apply(expr_mat, 1, var) > 0
  stopifnot(sum(variable) >= 2)
  pca <- prcomp(t(expr_mat[variable, , drop = FALSE]), scale. = TRUE)
  scores <- pca$x[, 1:2, drop = FALSE]
  # Degenerate PC scores are assigned z = 0 rather than flagged as outliers.
  zscore <- function(x) if (sd(x) == 0) rep(0, length(x)) else as.numeric(scale(x))
  df <- data.frame(SampleID = rownames(scores), scores,
                   Group = info$Group, Batch = info$Batch,
                   Z_PC1 = zscore(scores[, 1]), Z_PC2 = zscore(scores[, 2]))
  df$Flagged <- abs(df$Z_PC1) > z_cutoff | abs(df$Z_PC2) > z_cutoff
  variance <- 100 * pca$sdev^2 / sum(pca$sdev^2)
  p <- ggplot(df, aes(PC1, PC2, color = Group, shape = Flagged)) +
    geom_point(size = 3) + theme_bw() +
    labs(title = stage, x = sprintf("PC1 (%.1f%%)", variance[1]),
         y = sprintf("PC2 (%.1f%%)", variance[2]))
  ggsave(file.path(preprocess_dir, paste0(stage, "_PCA.png")), p, width = 7, height = 5)
  write.xlsx(df, file.path(preprocess_dir, paste0(stage, "_PCA.xlsx")), overwrite = TRUE)
  df
}
pca_before <- make_pca(expr_norm, meta, "Before_batch_correction")
write.xlsx(as.data.frame(table(meta$Batch, meta$Group)),
           file.path(preprocess_dir, "Batch_by_group.xlsx"), overwrite = TRUE)

# ComBat preserves the group effect. Confounded designs stop for review.
# There is no fallback that discards the biological group model.
expr_batch <- expr_norm
if (nlevels(meta$Batch) > 1) {
  design <- model.matrix(~ Batch + Group, meta)
  if (qr(design)$rank < ncol(design)) stop("Batch and group are confounded; review the design")
  if (nrow(design) <= ncol(design)) stop("No residual degrees of freedom")
  if (any(table(meta$Batch) < 2)) stop("Each batch requires at least two samples for this workflow")
  expr_batch <- sva::ComBat(dat = expr_norm, batch = meta$Batch,
                            mod = model.matrix(~ Group, meta),
                            par.prior = TRUE, prior.plots = FALSE)
}
pca_after <- make_pca(expr_batch, meta, "After_batch_correction")
# Flags are exported only. Review them before editing reviewed_exclusions and rerunning.
write.xlsx(pca_after[pca_after$Flagged, ],
           file.path(preprocess_dir, "Samples_flagged_for_review.xlsx"), overwrite = TRUE)
