# ===============================================================
# EXPLORATORY BINARY / MULTICLASS ML: RANDOM FOREST + ELASTIC NET
# ===============================================================
# IMPORTANT: global DEG selection, RMA, representative-probe selection, and
# group-aware ComBat precede splits. Metrics below are exploratory and can be
# optimistic. They are NOT independent validation or deployment estimates.
# For validated prediction, perform all learned preprocessing and feature
# selection within training resamples and use an independent evaluation cohort.

library(randomForest)
library(glmnet)
library(pROC)
library(tidyr)

# One job per feature set and outcome definition; add rows as needed.
# The feature_set value matches the comparison name in deg_files above.
# Binary: two classes separated by ';', with the positive class LAST.
# Multiclass: list all desired classes, separated by ';'.
# To merge original classes, add a separate outcome column to metadata yourself.
ml_jobs <- data.frame(
  name = c("Binary_model", "Multiclass_model"),
  feature_set = c("Comparison_A", "Comparison_A"),
  outcome_column = c("Group", "Group"),
  classes = c("Group_A;Group_B", "Group_A;Group_B;Group_C"),
  stringsAsFactors = FALSE
)
n_repeats <- 50L
train_fraction <- 0.8
top_n <- 100L
inner_folds <- 5L
ntree <- 1000L
elastic_alpha <- 0.5
stability_fraction <- 0.5
stopifnot(n_repeats >= 1, train_fraction > 0, train_fraction < 1,
          inner_folds >= 3, top_n >= 1, stability_fraction > 0, stability_fraction <= 1,
          !anyDuplicated(ml_jobs$name), all(grepl("^[A-Za-z][A-Za-z0-9_-]*$", ml_jobs$name)))

get_roc <- function(y, prob, classes) {
  if (length(classes) == 2) {
    pROC::roc(y, prob[, classes[2]], levels = classes, direction = "<", quiet = TRUE)
  } else {
    # Micro-average one-versus-rest indicators using class-major ordering.
    truth <- sapply(classes, function(cl) as.integer(y == cl))
    pROC::roc(as.vector(truth), as.vector(prob[, classes, drop = FALSE]),
              levels = c(0, 1), direction = "<", quiet = TRUE)
  }
}

for (job_i in seq_len(nrow(ml_jobs))) {
  job <- ml_jobs[job_i, ]
  stopifnot(job$feature_set %in% names(feature_sets), job$outcome_column %in% names(meta))
  classes <- strsplit(job$classes, ";", fixed = TRUE)[[1]]
  stopifnot(length(classes) >= 2, !anyDuplicated(classes))
  selected <- !is.na(meta[[job$outcome_column]]) & meta[[job$outcome_column]] %in% classes
  info <- meta[selected, , drop = FALSE]
  y <- factor(info[[job$outcome_column]], levels = classes)
  genes <- feature_sets[[job$feature_set]]
  if (length(genes) < 2) stop("Fewer than two matched consensus genes: ", job$feature_set)
  x <- t(expr_gene[genes, info$SampleID, drop = FALSE])
  stopifnot(all(is.finite(x)), all(table(y) >= 4))
  folder <- file.path(ml_dir, job$name)
  dir.create(folder, recursive = TRUE, showWarnings = FALSE)
  writeLines(c("Exploratory repeated holdouts with global preprocessing and feature selection.",
               "AUC and accuracy are not independent validation estimates.",
               "Repeated holdouts overlap; summaries are descriptive, without confidence intervals."),
             file.path(folder, "Interpretation.txt"))
  perf <- list()
  predictions <- list()
  confusions <- list()
  selections <- list()
  splits <- list()

  for (iteration in seq_len(n_repeats)) {
    message("Exploratory model: ", job$name, " | repeat ", iteration)
    set.seed(1234 + iteration)
    # Stratified holdout: retain both training and test observations per class.
    train <- unlist(lapply(classes, function(cl) {
      idx <- which(y == cl)
      n <- min(length(idx) - 1L, max(3L, floor(length(idx) * train_fraction)))
      sample(idx, n)
    }), use.names = FALSE)
    test <- setdiff(seq_len(nrow(x)), train)
    y_train <- y[train]
    y_test <- y[test]
    # Drop zero-variance features using training data only.
    variable <- apply(x[train, , drop = FALSE], 2, var) > 0
    if (sum(variable) < 2) stop("Too few variable training features in ", job$name)
    x_train <- x[train, variable, drop = FALSE]
    x_test <- x[test, variable, drop = FALSE]
    counts <- table(y_train)
    class_weights <- max(counts) / counts
    sample_weights <- as.numeric(class_weights[as.character(y_train)])
    splits[[iteration]] <- data.frame(Iteration = iteration, SampleID = rownames(x),
                                      Partition = ifelse(seq_len(nrow(x)) %in% train, "Train", "Test"))

    # RANDOM FOREST
    rf <- randomForest::randomForest(x = x_train, y = y_train,
                                     ntree = ntree, importance = TRUE, classwt = class_weights)
    rf_prob <- predict(rf, x_test, type = "prob")[, classes, drop = FALSE]
    importance <- randomForest::importance(rf, type = 2)[, 1]
    rf_genes <- names(sort(importance, decreasing = TRUE))[seq_len(min(top_n, length(importance)))]

    # ELASTIC NET: inner stratified CV; glmnet standardizes within each fit.
    folds <- min(inner_folds, min(counts))
    stopifnot(folds >= 3)
    foldid <- integer(length(y_train))
    for (cl in classes) {
      idx <- which(y_train == cl)
      foldid[idx] <- sample(rep(seq_len(folds), length.out = length(idx)))
    }
    family <- if (length(classes) == 2) "binomial" else "multinomial"
    enet <- glmnet::cv.glmnet(x_train, y_train, family = family,
                              alpha = elastic_alpha, foldid = foldid,
                              weights = sample_weights, standardize = TRUE,
                              type.measure = "deviance")
    prediction <- predict(enet, newx = x_test, s = "lambda.min", type = "response")
    if (length(classes) == 2) {
      enet_prob <- cbind(1 - as.numeric(prediction), as.numeric(prediction))
      colnames(enet_prob) <- classes
    } else {
      enet_prob <- matrix(prediction[, , 1], nrow = nrow(x_test), ncol = length(classes),
                           dimnames = list(rownames(x_test), dimnames(prediction)[[2]]))
      enet_prob <- enet_prob[, classes, drop = FALSE]
    }
    coefficients <- coef(enet, s = "lambda.min")
    if (!is.list(coefficients)) coefficients <- list(coefficients)
    enet_genes <- unique(unlist(lapply(coefficients, function(mat) {
      rownames(mat)[as.numeric(mat[, 1]) != 0 & rownames(mat) != "(Intercept)"]
    }), use.names = FALSE))
    # RF counts top-N importances; ENet counts nonzero coefficients (different definitions).
    selections[[iteration]] <- bind_rows(
      data.frame(Iteration = rep(iteration, length(rf_genes)), Model = rep("RF", length(rf_genes)), Gene = rf_genes),
      data.frame(Iteration = rep(iteration, length(enet_genes)), Model = rep("ENet", length(enet_genes)), Gene = enet_genes))

    for (model in c("RF", "ENet")) {
      prob <- if (model == "RF") rf_prob else enet_prob
      predicted <- factor(classes[max.col(prob, ties.method = "first")], levels = classes)
      roc <- get_roc(y_test, prob, classes)
      perf[[length(perf) + 1]] <- data.frame(Iteration = iteration, Model = model,
                                            AUC = as.numeric(pROC::auc(roc)),
                                            Accuracy = mean(predicted == y_test))
      pred <- data.frame(Iteration = iteration, Model = model, SampleID = rownames(x_test),
                         Reference = as.character(y_test), Prediction = as.character(predicted))
      predictions[[length(predictions) + 1]] <- cbind(pred, as.data.frame(prob, check.names = FALSE))
      cm <- as.data.frame(table(Prediction = predicted, Reference = y_test))
      cm$Iteration <- iteration
      cm$Model <- model
      confusions[[length(confusions) + 1]] <- cm
      # Fixed first-repeat ROC, rather than selecting the best test-set repeat.
      if (iteration == 1) {
        png(file.path(folder, paste0(model, "_ROC_first_repeat.png")), width = 1500, height = 1200, res = 200)
        plot(roc, main = paste("Exploratory", model, if (length(classes) > 2) "micro-averaged ROC" else "ROC"))
        dev.off()
      }
    }
    saveRDS(list(RF = rf, ENet = enet, features = colnames(x_train), classes = classes,
                 train = rownames(x_train), test = rownames(x_test)),
            file.path(folder, paste0("Models_repeat_", iteration, ".rds")))
  }

  # PERFORMANCE, PREDICTIONS, CONFUSION MATRICES, AND SELECTION STABILITY
  performance <- bind_rows(perf)
  summary <- performance %>% group_by(Model) %>%
    summarise(Mean_AUC = mean(AUC), SD_AUC = sd(AUC), Mean_accuracy = mean(Accuracy),
               SD_accuracy = sd(Accuracy), .groups = "drop")
  write.xlsx(list(Per_repeat = performance, Descriptive_summary = summary),
             file.path(folder, "Exploratory_performance.xlsx"), overwrite = TRUE)
  write.xlsx(bind_rows(predictions), file.path(folder, "Predictions.xlsx"), overwrite = TRUE)
  write.xlsx(bind_rows(splits), file.path(folder, "Sample_splits.xlsx"), overwrite = TRUE)
  confusion <- bind_rows(confusions)
  confusion_summary <- confusion %>% group_by(Model, Prediction, Reference) %>%
    summarise(Total = sum(Freq), Mean = mean(Freq), .groups = "drop")
  write.xlsx(list(Per_repeat = confusion, Summary = confusion_summary),
             file.path(folder, "Confusion_matrices.xlsx"), overwrite = TRUE)
  selection_table <- bind_rows(selections)
  frequency <- selection_table %>% distinct(Iteration, Model, Gene) %>%
    count(Gene, Model, name = "Frequency") %>%
    pivot_wider(names_from = Model, values_from = Frequency, values_fill = 0)
  for (model in c("RF", "ENet")) if (!model %in% names(frequency)) frequency[[model]] <- 0L
  frequency <- frequency %>% mutate(Total = RF + ENet,
                                     Stability_score = Total / (2 * n_repeats)) %>% arrange(desc(Total))
  threshold <- ceiling(n_repeats * stability_fraction)
  write.xlsx(list(Selections = selection_table, Frequency = frequency,
                  Stable = frequency %>% filter(RF >= threshold | ENet >= threshold),
                  Common_models = frequency %>% filter(RF > 0, ENet > 0)),
             file.path(folder, "Feature_stability.xlsx"), overwrite = TRUE)
  if (nrow(frequency)) {
    top <- head(frequency, 20)
    p <- ggplot(top, aes(reorder(Gene, Total), Total)) + geom_col() + coord_flip() +
      theme_bw() + labs(title = "Exploratory feature selection frequency", x = NULL, y = "Total selections")
    ggsave(file.path(folder, "Feature_stability.png"), p, width = 7, height = 6)
    if (requireNamespace("pheatmap", quietly = TRUE)) {
      mat <- as.matrix(head(frequency[, c("RF", "ENet")], 50))
      rownames(mat) <- head(frequency$Gene, 50)
      pheatmap::pheatmap(mat, cluster_rows = nrow(mat) > 1, cluster_cols = FALSE,
                        filename = file.path(folder, "Stability_heatmap.png"))
    }
  }
}

